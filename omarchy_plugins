#!/usr/bin/env bash

# World Clock
#
# https://github.com/ptgamr/oma-world-clock
omarchy plugin add https://github.com/ptgamr/oma-world-clock.git --enable

# Zen Lock - custom lock screen (wallpaper, avatar, blur, dim)
#
# https://github.com/rover-001/zen-lock
omarchy plugin add https://github.com/rover-001/zen-lock.git --enable

if [ -f ~/Pictures/kvacm-2020/sunset_6k_nofont.jpg ]; then
    ~/.config/omarchy/plugins/zen.lock/bin/zen-lock wallpaper ~/Pictures/kvacm-2020/sunset_6k_nofont.jpg
else
    echo "Zen Lock wallpaper not found: ~/Pictures/kvacm-2020/sunset_6k_nofont.jpg"
fi
~/.config/omarchy/plugins/zen.lock/bin/zen-lock darken 0.1
~/.config/omarchy/plugins/zen.lock/bin/zen-lock blur off

# OmaVideos
#
# https://plugins.omarchy.org/plugin.html?id=bhanu.omavideos
omarchy plugin add https://github.com/Bhanu4417/OmaVideos.git --enable

# Power + Battery Health
omarchy plugin add https://github.com/patcastle/omarchy-battery-health.git --enable

# Port Watch
#
# https://github.com/ZerubbabelT/portwatch
omarchy plugin add https://github.com/ZerubbabelT/portwatch.git --enable

# From Competition:
# https://omarchy.org/news/2026/08/the-first-plugin-competition-winners/
#

# Download Viedos from X, YT, etc.
#
omarchy plugin add https://github.com/Bhanu4417/OmaVideos.git --enable

# Load a whole desk in one click: workspaces, windows and services per project
#
omarchy plugin add https://github.com/novuon/omarchy_tableau.git --enable

#
# Memory Usage: Compact memory usage with an iStat-inspired pressure, composition, process, paging, and swap panel
#
omarchy plugin add https://github.com/egoist/omarchy-memory-usage.git --enable

# The Omarchy bar split into floating rounded islands for the left, center, and right sections.
# https://plugins.omarchy.org/plugin.html?id=lobo.islands
#
omarchy plugin add https://github.com/DanielLob-o/Islands.git --enable
