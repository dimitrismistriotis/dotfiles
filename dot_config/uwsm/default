# Changes require a restart to take effect.
#
# NOTE (Omarchy 4 "Quarto"): these env vars no longer decide what the Hyprland
# bindings launch. Super+Return goes through xdg-terminal-exec, and
# Super+Shift+B runs omarchy-launch-browser, which explicitly ignores $BROWSER
# (`env -u BROWSER xdg-settings get default-web-browser`).
# The desktop defaults live in:
#   ~/.config/xdg-terminals.list  (terminal)
#   ~/.config/mimeapps.list       (browser)
# and are set by `make omarchy_default_apps`. Keep the values below in sync;
# they still apply to CLI tools that honour $TERMINAL / $BROWSER.

# Install other terminals via Install > Terminal
export TERMINAL=ghostty

# Use code for VSCode
export EDITOR=nvim

# Use a custom directory for screenshots (remember to make the directory!)
# export OMARCHY_SCREENSHOT_DIR="$HOME/Pictures/Screenshots"

# Use a custom directory for screenrecordings (remember to make the directory!)
# export OMARCHY_SCREENRECORD_DIR="$HOME/Videos/Screencasts"

export BROWSER=brave
